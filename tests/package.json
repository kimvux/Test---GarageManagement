{
  "name": "autogara-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Bộ kiểm thử AutoGara (Cypress API + E2E, c8 coverage). Không chứa mã sản phẩm.",
  "scripts": {
    "setup": "node scripts/setup.js",
    "check": "node scripts/check-tests.js",
    "db:up": "node scripts/database.js up",
    "db:stop": "node scripts/database.js stop",
    "backend": "node scripts/backend.js",
    "backend:cov": "node scripts/backend.js --coverage",
    "backend:stop": "node -e \"require('fs').writeFileSync('.stop-backend','')\"",
    "frontend": "node scripts/frontend.js",
    "seed": "node scripts/seed.js",
    "test:api": "node scripts/run.js api",
    "test:ui": "node scripts/run.js ui",
    "test:dashboard": "node scripts/run.js dashboard",
    "test": "node scripts/run.js all",
    "cy:open": "node scripts/run.js open"
  },
  "engines": { "node": ">=22" },
  "devDependencies": {
    "bcryptjs": "^2.4.3",
    "c8": "^10.1.3",
    "cypress": "^13.17.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
